From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Armbian <info@armbian.com>
Date: Tue, 21 Oct 2026 00:00:00 +0000
Subject: drm/bridge: inno-hdmi: add I2S audio support

Register an HDMI codec through the bridge HDMI audio operations.
Program the I2S input, the sample rate, and the N value.
Send the audio infoframe and restore the setup after a mode set.

---
--- a/drivers/gpu/drm/bridge/inno-hdmi.c
+++ b/drivers/gpu/drm/bridge/inno-hdmi.c
@@ -30,6 +30,8 @@
 #include <drm/display/drm_hdmi_helper.h>
 #include <drm/display/drm_hdmi_state_helper.h>
 
+#include <sound/hdmi-codec.h>
+
 #define DDC_SEGMENT_ADDR		0x30
 
 #define HDMI_SCL_RATE			(100 * 1000)
@@ -114,10 +116,12 @@
 #define HDMI_AV_MUTE			0x05
 #define m_AVMUTE_CLEAR			BIT(7)
 #define m_AVMUTE_ENABLE			BIT(6)
+#define m_AUDIO_PD			BIT(2)
 #define m_AUDIO_MUTE			BIT(1)
 #define m_VIDEO_BLACK			BIT(0)
 #define v_AVMUTE_CLEAR(n)		((n) << 7)
 #define v_AVMUTE_ENABLE(n)		((n) << 6)
+#define v_AUDIO_PD(n)			((n) << 2)
 #define v_AUDIO_MUTE(n)			((n) << 1)
 #define v_VIDEO_MUTE(n)			((n) << 0)
 
@@ -402,6 +406,13 @@
 	struct inno_hdmi_i2c *i2c;
 	struct i2c_adapter *ddc;
 	const struct inno_hdmi_plat_data *plat_data;
+
+	/* Last I2S stream setup, restored after a mode set. */
+	struct {
+		unsigned int sample_rate;
+		unsigned int channels;
+		bool configured;
+	} audio;
 };
 
 enum {
@@ -619,6 +630,145 @@
 	return 0;
 }
 
+static int inno_hdmi_bridge_clear_audio_infoframe(struct drm_bridge *bridge)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	hdmi_writeb(hdmi, HDMI_CONTROL_PACKET_BUF_INDEX, INFOFRAME_AAI);
+
+	return 0;
+}
+
+static int inno_hdmi_bridge_write_audio_infoframe(struct drm_bridge *bridge,
+						  const u8 *buffer, size_t len)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+	ssize_t i;
+
+	inno_hdmi_bridge_clear_audio_infoframe(bridge);
+
+	for (i = 0; i < len; i++)
+		hdmi_writeb(hdmi, HDMI_CONTROL_PACKET_ADDR + i, buffer[i]);
+
+	return 0;
+}
+
+static int inno_hdmi_audio_config(struct inno_hdmi *hdmi)
+{
+	unsigned int channel, rate, n;
+
+	if (hdmi->audio.channels <= 2)
+		channel = I2S_CHANNEL_1_2;
+	else if (hdmi->audio.channels <= 4)
+		channel = I2S_CHANNEL_3_4;
+	else if (hdmi->audio.channels <= 6)
+		channel = I2S_CHANNEL_5_6;
+	else
+		channel = I2S_CHANNEL_7_8;
+
+	switch (hdmi->audio.sample_rate) {
+	case 32000:
+		rate = AUDIO_32K;
+		n = N_32K;
+		break;
+	case 44100:
+		rate = AUDIO_441K;
+		n = N_441K;
+		break;
+	case 48000:
+		rate = AUDIO_48K;
+		n = N_48K;
+		break;
+	case 88200:
+		rate = AUDIO_882K;
+		n = N_882K;
+		break;
+	case 96000:
+		rate = AUDIO_96K;
+		n = N_96K;
+		break;
+	case 176400:
+		rate = AUDIO_1764K;
+		n = N_1764K;
+		break;
+	case 192000:
+		rate = AUDIO_192K;
+		n = N_192K;
+		break;
+	default:
+		dev_err(hdmi->dev, "unsupported audio sample rate %u\n",
+			hdmi->audio.sample_rate);
+		return -EINVAL;
+	}
+
+	/* I2S input, clocked from the I2S bit clock (no MCLK). */
+	hdmi_writeb(hdmi, HDMI_AUDIO_CTRL1, v_CTS_SOURCE(CTS_SOURCE_INTERNAL) |
+		    v_DOWN_SAMPLE(DOWNSAMPLE_DISABLE) |
+		    v_AUDIO_SOURCE(AUDIO_SOURCE_IIS) |
+		    v_MCLK_ENABLE(0) | v_MCLK_RATIO(MCLK_256FS));
+	hdmi_writeb(hdmi, AUDIO_SAMPLE_RATE, rate);
+	hdmi_writeb(hdmi, AUDIO_I2S_MODE, v_I2S_MODE(I2S_STANDARD) |
+		    v_I2S_CHANNEL(channel));
+	hdmi_writeb(hdmi, AUDIO_I2S_MAP, 0x00);
+	hdmi_writeb(hdmi, AUDIO_I2S_SWAPS_SPDIF, 0);
+
+	hdmi_writeb(hdmi, AUDIO_N_H, (n >> 16) & 0x0f);
+	hdmi_writeb(hdmi, AUDIO_N_M, (n >> 8) & 0xff);
+	hdmi_writeb(hdmi, AUDIO_N_L, n & 0xff);
+
+	hdmi_writeb(hdmi, HDMI_AUDIO_CHANNEL_STATUS, v_AUDIO_STATUS_NLPCM(0));
+
+	return 0;
+}
+
+static int inno_hdmi_bridge_audio_prepare(struct drm_bridge *bridge,
+					  struct drm_connector *connector,
+					  struct hdmi_codec_daifmt *fmt,
+					  struct hdmi_codec_params *hparms)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+	int ret;
+
+	if (fmt->fmt != HDMI_I2S) {
+		dev_err(hdmi->dev, "unsupported audio format %d\n", fmt->fmt);
+		return -EINVAL;
+	}
+
+	hdmi->audio.sample_rate = hparms->sample_rate;
+	hdmi->audio.channels = hparms->channels;
+
+	ret = inno_hdmi_audio_config(hdmi);
+	if (ret)
+		return ret;
+	hdmi->audio.configured = true;
+
+	return drm_atomic_helper_connector_hdmi_update_audio_infoframe(connector,
+								       &hparms->cea);
+}
+
+static int inno_hdmi_bridge_audio_mute_stream(struct drm_bridge *bridge,
+					      struct drm_connector *connector,
+					      bool enable, int direction)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	hdmi_modb(hdmi, HDMI_AV_MUTE, m_AUDIO_MUTE | m_AUDIO_PD,
+		  v_AUDIO_MUTE(enable) | v_AUDIO_PD(enable));
+
+	return 0;
+}
+
+static void inno_hdmi_bridge_audio_shutdown(struct drm_bridge *bridge,
+					    struct drm_connector *connector)
+{
+	struct inno_hdmi *hdmi = bridge_to_inno_hdmi(bridge);
+
+	hdmi_modb(hdmi, HDMI_AV_MUTE, m_AUDIO_MUTE | m_AUDIO_PD,
+		  v_AUDIO_MUTE(1) | v_AUDIO_PD(1));
+	hdmi->audio.configured = false;
+	drm_atomic_helper_connector_hdmi_clear_audio_infoframe(connector);
+}
+
 static int inno_hdmi_config_video_csc(struct inno_hdmi *hdmi,
 				      struct drm_connector *connector,
 				      struct drm_display_mode *mode)
@@ -786,6 +936,9 @@
 
