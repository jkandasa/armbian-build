Replace strncpy() with strscpy(). Linux 7.3 removed strncpy().

diff -ruN a/hwif/sdio/sdio.c b/hwif/sdio/sdio.c
--- a/hwif/sdio/sdio.c
+++ b/hwif/sdio/sdio.c
@@ -2074,9 +2074,9 @@
     }
 
     if (*c != 0) {
-        strncpy(glue->tmp_data.chip_id, c, SSV6XXX_CHIP_ID_LENGTH);
+        strscpy((char *)glue->tmp_data.chip_id, c, SSV6XXX_CHIP_ID_LENGTH);
         dev_info(glue->dev, "CHIP ID: %s \n", glue->tmp_data.chip_id);
-        strncpy(glue->tmp_data.short_chip_id, c, SSV6XXX_CHIP_ID_SHORT_LENGTH);
+        strscpy((char *)glue->tmp_data.short_chip_id, c, SSV6XXX_CHIP_ID_SHORT_LENGTH + 1);
         glue->tmp_data.short_chip_id[SSV6XXX_CHIP_ID_SHORT_LENGTH] = 0;
     } else {
         dev_err(glue->dev, "Failed to read chip ID");
