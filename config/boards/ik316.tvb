# Allwinner H616 IK316 eMCP 1GB LPDDR3 8GB eMMC WiFi TV box
BOARD_NAME="IK316 eMCP"
BOARD_VENDOR="allwinner"
BOARDFAMILY="sun50iw9"
BOARD_MAINTAINER=""
INTRODUCED="2026"
BOOTCONFIG="ik316_defconfig"
BOOT_FDT_FILE="sun50i-h616-ik316.dtb"
BOOT_LOGO="desktop"
KERNEL_TARGET="current,edge"
KERNEL_TEST_TARGET="current"
FORCE_BOOTSCRIPT_UPDATE="yes"
OVERLAY_PREFIX="sun50i-h616"
enable_extension "ssv6x5x"
